<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
            http://www.springframework.org/schema/beans/spring-beans.xsd
            http://www.springframework.org/schema/context
            http://www.springframework.org/schema/context/spring-context-3.0.xsd">
            
         <!-- Beans -->   
         <bean id="car1" class="org.jsp.Car">
         	<property name="id" value="101"></property>
         	<property name="modelName" value="Apple I car"></property>
         	<property name="mileage" value="15"></property>
         	<property name="engine" ref="engine1"></property>
         </bean>
         
         <bean id="engine1" class="org.jsp.Engine">
         	<constructor-arg name="id" value="1001"></constructor-arg>
         	<constructor-arg name="engineName" value="Maruti-hipower"></constructor-arg>
         	<constructor-arg name="engineType" value="V8"></constructor-arg>
         </bean>
         
</beans>